	<!-- particle at bottom of tree entrance -->
	<glow x="282" y="45" size="45" numParticles="5" speed="1" r="255" g="255" b="255"/>	
	
	
	<!-- large wheel at top -->
	<circle x="165" y="300" mass="15" radius="45" file="circler45.png" visible="true" tag="40201" type="40201" group="40201"/>
	<pivot toTag="40201" fromTag="-1" toX="0" toY="0" fromX="165" fromY="300" visible="false"/>

	<!-- top gear -->
	<circle x="165" y="155" mass="3" radius="25" file="circler25.png" visible="true" tag="40203" type="40203"/>	

	<!-- connect large wheel to gear -->
	<pin toTag="40203" fromTag="40201" fromY="-45" visible="true"/> 
	
	<fuzzles/>
	
